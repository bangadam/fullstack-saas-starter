{
  "name": "saas-boilerplate",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "bootstrap": "pnpm --filter @saas/cli build && node scripts/bootstrap.mjs",
    "deploy:staging": "pnpm --filter @saas/cli build && node scripts/deploy.mjs --env staging",
    "deploy:production": "pnpm --filter @saas/cli build && node scripts/deploy.mjs --env production",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "smoke": "node scripts/smoke.mjs",
    "smoke:lifecycle": "node scripts/lifecycle-smoke.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "operations": "node scripts/operations.mjs",
    "scan:secrets": "pnpm --filter @saas/cli build && node packages/cli/bin/saas.js scan-secrets",
    "dev": "node scripts/dev.mjs",
    "stop": "node scripts/stop.mjs",
    "restart": "pnpm stop && pnpm dev",
    "wizard": "pnpm --filter @saas/cli build && node packages/cli/bin/saas.js setup",
    "db:migrate": "pnpm --filter @saas/api exec wrangler d1 migrations apply saas-db --local",
    "db:seed": "node scripts/seed.mjs",
    "check": "pnpm --filter @saas/cli build && node packages/cli/bin/saas.js doctor"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3"
  }
}
