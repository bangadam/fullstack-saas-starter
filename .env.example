# Variable NAMES only — no values. Copy per-app values into .dev.vars (gitignored)
# or upload to Cloudflare via `wrangler secret put`. Do not commit real secrets.

# ── apps/web (public vars; secrets go to apps/api) ─────────────────────────
# Public base URL of the web app (origin used by Better Auth and OAuth callback)
APP_BASE_URL=
# (Tidak perlu lagi) auth links derive from APP_BASE_URL + /api automatically
BETTER_AUTH_URL=
# Turnstile site key (public); secret key lives in apps/api
TURNSTILE_SITE_KEY=
# API also receives this public key for authenticated account security challenges.

# ── apps/api (.dev.vars / wrangler secret put) ─────────────────────────────
# Better Auth secret — must differ between staging and production
BETTER_AUTH_SECRET=
# Google OAuth credentials (redirect: <APP_BASE_URL>/api/auth/callback/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Turnstile server-side verification (empty = widget disabled, dev only)
TURNSTILE_SECRET_KEY=
# Origins allowed to perform cookie-authenticated writes (comma-separated,
# APP_URL is always allowed). Empty in local dev.
EXTRA_ALLOWED_ORIGINS=
# Rate limit overrides as "limit/windowSeconds" (unset = strict defaults:
# credential endpoints 10/600s, other writes 120/60s, webhooks 120/60s)
RATE_LIMIT_AUTH_STRICT=
RATE_LIMIT_WRITE=
RATE_LIMIT_WEBHOOKS=
# Email adapter (Resend) — empty key = local email capture in dev
RESEND_API_KEY=
# Billing adapter Polar (default)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
# Billing adapter Stripe (alternative to Polar)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# R2 presigned uploads (API only); bucket name must match BUCKET binding.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ── apps/jobs (.dev.vars / wrangler secret put) ────────────────────────────
# Billing token only if jobs need provider API access
BILLING_API_TOKEN=

# ── Cloudflare (MCP + wrangler deploy) ─────────────────────────────────────
# API token: dash.cloudflare.com → My Profile → API Tokens → Create Token
# Minimal scopes untuk boilerplate ini:
#   Account: Workers Scripts:Edit, D1:Edit, Workers KV Storage:Edit,
#            Workers R2 Storage:Edit, Queues:Edit
#   User:    Memberships:Read, User Details:Read
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Diisi otomatis setelah `wrangler login` (OAuth) — tidak perlu diisi manual
# jika memakai wrangler login di lokal.

# Notes:
# - D1/R2/Queue bindings are defined in each app's wrangler.jsonc, NOT here.
# - Same variable may need different values per environment (staging/production);
#   shared auth secret stays consistent across API replicas but differs per env.
