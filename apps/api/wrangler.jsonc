{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "saas-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-10-01",
  // better-auth relies on AsyncLocalStorage (node:async_hooks) for request context;
  // packages/domain+storage use node:crypto for id/HMAC, so full nodejs_compat.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Local dev only — jobs worker defaults to 8788, so api must not collide.
  "dev": {
    "port": 8787
  },
  // Private worker: no routes/workers.dev. Web Worker forwards /api/* and /webhooks/*
  // via service binding, forwarding both prefixes unchanged.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "saas-db",
      "database_id": "REPLACE_WITH_D1_ID",
      // SQL migrations generated by drizzle-kit live in packages/db/drizzle;
      // symlinked into migrations/ so `wrangler d1 migrations apply` finds them.
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "saas-files"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "EMAIL_QUEUE",
        "queue": "saas-email-queue"
      },
      {
        "binding": "BILLING_QUEUE",
        "queue": "saas-billing-queue"
      }
    ]
  },
  "vars": {
    "APP_URL": "http://localhost:3000",
    // Extra origins allowed for cookie-authenticated writes (comma-separated).
    "EXTRA_ALLOWED_ORIGINS": "",
    // Rate limits as "limit/windowSeconds". Dev is looser so iteration and the
    // e2e suite are not throttled; production leaves these unset (strict
    // defaults: 10/600s for credential endpoints, 120/60s for other writes).
    "RATE_LIMIT_AUTH_STRICT": "60/600",
    "RATE_LIMIT_WRITE": "600/60",
    "RATE_LIMIT_WEBHOOKS": "600/60",
    "BILLING_PROVIDER": "polar",
    "POLAR_ENVIRONMENT": "sandbox",
    "R2_BUCKET_NAME": "saas-files",
    "ENVIRONMENT": "development"
  },
  "env": {
    // Worker name for staging — web staging binds to this via API_WORKER service.
    "staging": {
      "name": "saas-api-staging",
      "vars": {
        "APP_URL": "https://saas-web-staging.bangadam-dev.workers.dev",
        // Extra origins allowed for cookie-authenticated writes (comma-separated).
        "EXTRA_ALLOWED_ORIGINS": "",
        "BILLING_PROVIDER": "polar",
        "POLAR_ENVIRONMENT": "sandbox",
        "R2_BUCKET_NAME": "saas-files-staging",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "saas-db-staging",
          "database_id": "8893886a-0cee-457a-a4f5-9911471b5716",
          "migrations_dir": "../../packages/db/drizzle"
        }
      ],
      // R2 belum diaktifkan di akun (API error 10042). Binding placeholder
      // agar deploy jalan; aktifkan R2 lalu isi bucket_name asli.
      "r2_buckets": [
        {
          "binding": "BUCKET",
          "bucket_name": "saas-files-staging"
        }
      ],
      "queues": {
        "producers": [
          { "binding": "EMAIL_QUEUE", "queue": "saas-email-queue-staging" },
          { "binding": "BILLING_QUEUE", "queue": "saas-billing-queue-staging" }
        ]
      }
    }
  }
}
